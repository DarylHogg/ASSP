<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Oauth2ClientCredFlow</authenticationProtocol>
    <description>OAuth 2.0 client credentials flow for Microsoft Graph API. Configure Client ID, Client Secret, and Tenant ID in Setup after deployment.</description>
    <label>Microsoft Graph</label>
    <principals>
        <parameterName>MicrosoftGraph_NamedPrincipal</parameterName>
        <principalType>NamedPrincipal</principalType>
        <sequenceNumber>1</sequenceNumber>
    </principals>
    <externalCredentialParameters>
        <parameterName>token_endpoint</parameterName>
        <parameterType>AuthProviderUrl</parameterType>
        <parameterValue>https://login.microsoftonline.com/YOUR_TENANT_ID/oauth2/v2.0/token</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterName>scope</parameterName>
        <parameterType>AuthParameter</parameterType>
        <parameterValue>https://graph.microsoft.com/.default</parameterValue>
        <sequenceNumber>2</sequenceNumber>
    </externalCredentialParameters>
</ExternalCredential>
