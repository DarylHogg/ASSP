<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowFormula>false</allowFormula>
    <description>Microsoft Graph API endpoint for SharePoint file access. Requires MicrosoftGraph External Credential with OAuth 2.0 client credentials configured.</description>
    <externalCredential>MicrosoftGraph</externalCredential>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <label>Microsoft Graph</label>
    <namedCredentialParameters>
        <parameterName>Url</parameterName>
        <parameterType>Url</parameterType>
        <parameterValue>https://graph.microsoft.com</parameterValue>
    </namedCredentialParameters>
    <principalType>NamedPrincipal</principalType>
    <type>SecuredEndpoint</type>
</NamedCredential>
