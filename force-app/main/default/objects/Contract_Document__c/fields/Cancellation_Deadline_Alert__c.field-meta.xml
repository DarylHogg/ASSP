<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cancellation_Deadline_Alert__c</fullName>
    <formula>AND(
    NOT(ISBLANK(Cancellation_Notice_Due_Date__c)),
    Cancellation_Notice_Due_Date__c - TODAY() &lt;= 30,
    Cancellation_Notice_Due_Date__c &gt;= TODAY()
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Cancellation Deadline Within 30 Days</label>
    <trackHistory>false</trackHistory>
    <type>Checkbox</type>
</CustomField>
