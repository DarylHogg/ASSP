    <template>
        <name>RecordLayout2</name>
    </template>
    <type>RecordPage</type>

    <!-- ─── Header: Highlights Panel ─── -->
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>showTitle</name>
