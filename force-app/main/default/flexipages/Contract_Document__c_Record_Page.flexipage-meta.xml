                </componentInstanceProperties>
                <componentName>force:recordDetail</componentName>
            </componentInstance>
        </itemInstances>
        <name>main</name>
        <type>Region</type>
    </flexiPageRegions>

    <!-- ─── Sidebar: Files + Activity ─── -->
